{
  "name": "walmart-qa-challenge",
  "version": "1.0.0",
  "description": "Automated functional tests for opencart.abstracta.us using Playwright, TypeScript and Cucumber",
  "scripts": {
    "test": "cucumber-js",
    "test:headed": "cross-env HEADED=true cucumber-js",
    "test:report": "cucumber-js --format html:reports/cucumber-report.html",
    "postinstall": "playwright install"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.8.0",
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.14.0",
    "cross-env": "^7.0.3",
    "playwright": "^1.44.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
